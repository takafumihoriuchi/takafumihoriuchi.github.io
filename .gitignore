# macOS
.DS_Store
._*

# Python bytecode. Regenerated on every run of scripts/, and .nojekyll would
# otherwise serve it at a public URL.
__pycache__/
*.pyc

# Claude Code personal settings
.claude/settings.local.json

# Operating rules — kept out of the repository because .nojekyll makes every
# committed file reachable at a public URL.
/OPERATIONS.md

# Source material a work page is derived from — Keynote files, the presentation
# and paper PDFs, full-resolution originals. Kept next to the work on this Mac,
# never committed: .nojekyll would put a 41 MB deck at a public URL, and
# everything the site actually serves is a derived asset in assets/.
/works/*/source/

# Local preview server config. Kept out for the same reason as OPERATIONS.md:
# .nojekyll would serve it at a public URL, and it describes this Mac, not the
# site. Recreate it with `python3 -m http.server` on any other machine.
/.claude/launch.json
